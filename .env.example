# Copy this file to .env (which is gitignored) and fill in real values.
# These are consumed by docker-compose.yml and substituted into config.yml
# via Frigate's {FRIGATE_*} environment variable templating.

# Password for Frigate's own restreamed RTSP/go2rtc output (not the camera credentials).
FRIGATE_RTSP_PASSWORD=change-me

# Shared login used for all camera RTSP/ONVIF streams.
FRIGATE_RTSP_USER=admin
FRIGATE_CAMERA_RTSP_PASSWORD=change-me
